# Copy to .env and fill in only the providers you use. ragX reads these by name and never logs them.
# Without model=, ragX uses the first provider whose key is set (see the Models page of the docs).

# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional: any OpenAI-compatible endpoint that takes a key
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# CEREBRAS_API_KEY=
# FIREWORKS_API_KEY=

# A vLLM (or other OpenAI-compatible) server for provider "vllm:"
# RAGX_VLLM_URL=http://localhost:8001/v1
# RAGX_VLLM_API_KEY=

# The default model when no key is set (a local model needs pyragx[local])
# RAGX_MODEL=hf:Qwen/Qwen3.5-4B
